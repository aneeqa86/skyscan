# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SETTINGS_MODULE=skyscan.settings.local

# Database (PostGIS). Inside docker compose the host is "db".
DB_NAME=skyscan
DB_USER=skyscan
DB_PASSWORD=skyscan
DB_HOST=db
DB_PORT=5432

# Redis. Inside docker compose the host is "redis".
REDIS_URL=redis://redis:6379/0

# CORS (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Processing
MEDIA_ROOT=/data/media
SKYSCAN_WORK_DIR=/data/work
SKYSCAN_CACHE_DIR=/data/cache
MAX_AOI_KM2_MEASURE=1.0
MAX_AOI_KM2_CHANGE=0.5
MAX_CONCURRENT_JOBS=4
JOB_CREATE_RATE=10/hour

# Sentry (production only)
SENTRY_DSN=

# Reference footprints (blank = newest Overture release)
OVERTURE_RELEASE=
